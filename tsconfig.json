{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "server",
    "app",
    "db",
    "tests",
    "cloudflare-env.d.ts",
    "vitest.config.ts"
  ]
}
